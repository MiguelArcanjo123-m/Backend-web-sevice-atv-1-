package com.exemplo.rede.controller;

import com.exemplo.rede.model.Tweet;
import com.exemplo.rede.model.Usuario;
import com.exemplo.rede.service.UsuarioService;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Map;
import java.util.UUID;

@RestController
@RequestMapping("/usuarios")
public class UsuarioController {

    private final UsuarioService usuarioService;

    public UsuarioController(UsuarioService usuarioService) {
        this.usuarioService = usuarioService;
    }

    @GetMapping
    public List<Usuario> listarUsuarios() {
        return usuarioService.listarUsuarios();
    }

    @GetMapping("/{id}/tweets")
    public ResponseEntity<List<Tweet>> listarTweets(@PathVariable UUID id) {
        return ResponseEntity.ok(usuarioService.listarTweets(id));
    }

    @PostMapping("/{id}/tweets")
    public ResponseEntity<Tweet> criarTweet(@PathVariable UUID id, @RequestBody Map<String, String> body) {
        String mensagem = body.get("mensagem");
        Tweet tweet = usuarioService.criarTweet(id, mensagem);
        return ResponseEntity.ok(tweet);
    }

    @PatchMapping("/{id}/tweets/{tweetId}")
    public ResponseEntity<Tweet> atualizarTweet(@PathVariable UUID id,
                                                @PathVariable UUID tweetId,
                                                @RequestBody Map<String, String> body) {
        String novaMensagem = body.get("mensagem");
        Tweet tweet = usuarioService.atualizarTweet(id, tweetId, novaMensagem);
        return ResponseEntity.ok(tweet);
    }

    @DeleteMapping("/{id}/tweets/{tweetId}")
    public ResponseEntity<Void> deletarTweet(@PathVariable UUID id,
                                             @PathVariable UUID tweetId) {
        usuarioService.removerTweet(id, tweetId);
        return ResponseEntity.noContent().build();
    }
}
