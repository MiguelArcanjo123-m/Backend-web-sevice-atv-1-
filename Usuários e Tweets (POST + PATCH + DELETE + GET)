package com.exemplo.rede.service;

import com.exemplo.rede.model.Tweet;
import com.exemplo.rede.model.Usuario;
import org.springframework.stereotype.Service;

import java.util.*;

@Service
public class UsuarioService {
    private List<Usuario> usuarios = new ArrayList<>();

    public UsuarioService() {
        // Inicializa alguns usuários de exemplo
        usuarios.add(new Usuario("Alice", "alice@email.com"));
        usuarios.add(new Usuario("Bob", "bob@email.com"));
    }

    public List<Usuario> listarUsuarios() {
        return usuarios;
    }

    public Optional<Usuario> buscarUsuario(UUID id) {
        return usuarios.stream()
                .filter(u -> u.getId().equals(id))
                .findFirst();
    }

    public List<Tweet> listarTweets(UUID usuarioId) {
        return buscarUsuario(usuarioId)
                .map(Usuario::getTweets)
                .orElse(Collections.emptyList());
    }

    public Tweet criarTweet(UUID usuarioId, String mensagem) {
        Usuario usuario = buscarUsuario(usuarioId)
                .orElseThrow(() -> new NoSuchElementException("Usuário não encontrado"));
        Tweet tweet = new Tweet(mensagem);
        usuario.getTweets().add(tweet);
        return tweet;
    }

    public Tweet atualizarTweet(UUID usuarioId, UUID tweetId, String novaMensagem) {
        Usuario usuario = buscarUsuario(usuarioId)
                .orElseThrow(() -> new NoSuchElementException("Usuário não encontrado"));
        Tweet tweet = usuario.getTweets().stream()
                .filter(t -> t.getTweetId().equals(tweetId))
                .findFirst()
                .orElseThrow(() -> new NoSuchElementException("Tweet não encontrado"));
        tweet.setMensagem(novaMensagem);
        tweet.setEditado(true);
        return tweet;
    }

    public void removerTweet(UUID usuarioId, UUID tweetId) {
        Usuario usuario = buscarUsuario(usuarioId)
                .orElseThrow(() -> new NoSuchElementException("Usuário não encontrado"));
        usuario.getTweets().removeIf(t -> t.getTweetId().equals(tweetId));
    }
}

